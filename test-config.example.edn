;; Copy this file to test-config.edn and adjust for your VTN.
;; test-config.edn is gitignored.

{:vtn-url "http://localhost:8080/openadr3/3.1.0"

 ;; Dual-URL config for two-port VTN architectures.
 ;; If your VTN serves BL (write) and VEN (read) clients on separate ports,
 ;; set :bl-url and :ven-url. If omitted, both fall back to :vtn-url.
 ;; :bl-url  "http://localhost:8081/openadr3/3.1.0"
 ;; :ven-url "http://localhost:8080/openadr3/3.1.0"

 ;; Auth tokens — must match your VTN's token configuration.
 :tokens {:ven1 "ven_token"
          :ven2 "ven_token2"
          :bl   "bl_token"
          :bad  "bad_token"}

 ;; Delay in ms between test suites.
 ;; Set to 0 for fast VTNs, 1000-5000 if you see connection errors.
 :inter-suite-delay-ms 1000

 ;; MQTT settle time in ms — how long to wait after clearing the message
 ;; buffer for retained messages to drain. Increase for slow brokers.
 ;; :mqtt-settle-ms 1000

 ;; MQTT await timeout in ms — max time to wait for expected notifications.
 ;; :mqtt-await-ms 10000

 ;; MQTT broker URI override. When set, wins over discovery from /notifiers —
 ;; useful when the VTN advertises a URI that's not reachable from the test
 ;; host (e.g. a Docker-internal hostname). Also serves as a fallback when
 ;; the VTN doesn't advertise MQTT at all.
 ;; :mqtt-brokers ["tcp://127.0.0.1:1883"]

 ;; ---- Capabilities — the canonical place to describe your VTN ----
 ;; The harness builds a merged capability profile at load time from four
 ;; sources, in priority order: declared (this map, highest) → advertised
 ;; (GET /notifiers) → auto-detected (HTTP probes) → defaulted. Each fact
 ;; carries its source in the report.
 ;;
 ;; You typically declare only what auto-detection can't know (or what you
 ;; want to assert in the report). :handlers, :transport, and :notifiers
 ;; are auto-detected; :ven-routes granularity (:full vs :read-only) and
 ;; :http-auth :enforced? cannot be reliably probed and are best declared.
 ;;
 ;; :capabilities
 ;; {:transport         {:single-port? false :bl-port 8081 :ven-port 8080}
 ;;  :http-auth         {:method :bearer-jwt :enforced? true
 ;;                      :on-bl? true :on-ven? true}
 ;;  :handlers          #{:programs :events :subscriptions :vens :resources :reports}
 ;;  :ven-routes        {:programs :read-only :events :read-only
 ;;                      :subscriptions :full :vens :full
 ;;                      :resources :full :reports :full}
 ;;  :notifiers         #{:WEBHOOK :MQTT}
 ;;  :mqtt-auth         {:method :anonymous}
 ;;  :webhook-delivery? false
 ;;  :discovery         #{:static-url}}

 ;; ---- Legacy keys (DEPRECATED — migrate to :capabilities above) ----
 ;; These are still accepted for one deprecation cycle. Each emits a
 ;; one-time warning at startup if used. New code should use the
 ;; :capabilities map above.
 ;;
 ;; :auth-enforced? false               ;; → :capabilities {:http-auth {:enforced? false}}
 ;; :expected-notifiers #{:MQTT}        ;; → :capabilities {:notifiers #{:MQTT}}
 ;; :ven-routes {:subscriptions false   ;; → :capabilities {:ven-routes {...}}
 ;;              :vens          false
 ;;              :resources     false
 ;;              :reports       false}
 }
