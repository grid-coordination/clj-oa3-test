;; Test configuration — clj-oa3-vtn 0.12.1 (default VEN routes)
;; Two-port architecture (BL on 8081, VEN on 8080), VEN subscriptions
;; disabled by default.
;;
;; clj-oa3-vtn 0.12.1 implements: programs, events, subscriptions, notifiers,
;; MQTT publish, and the 12 MQTT topic discovery endpoints. VENs, resources,
;; and reports handlers are not yet implemented — focus only the suites that
;; the VTN supports.
;;
;; Auth: not enforced in 0.12.1 (Phase 1 — BL is trusted by topology, VEN is
;; public-read). :auth-enforced? false below short-circuits the ^:auth tests.
;; Notifiers: MQTT only — no WEBHOOK delivery yet.
;;
;; Known failures observed against 0.12.1 (2026-05-08, anonymous MQTT):
;;   - programs / test-update-program-bl: PUT /programs returns 500 when
;;     :targets is a vector of strings (e.g. ["group1"]). Update path
;;     regression vs. 0.5.0.
;;   - events / test-search-all-events-bl: GET /events returns an empty body
;;     even when events exist.
;;   - events / test-search-events-by-program-id: same — filter doesn't return
;;     matches.
;;   - events / test-search-events-pagination: skip/limit return 0 items when
;;     1 is expected.
;; All other tests in the focused suites pass (notifiers + subscriptions clean;
;; programs 14/15 non-auth, events 12/15 non-auth).
;;
;; Usage:
;;   cp test-config.clj-oa3-vtn.edn test-config.edn
;;   # Start clj-oa3-vtn and mosquitto, then:
;;   clojure -M:test --focus :notifiers --focus :programs --focus :events \
;;                   --focus :subscriptions

{;; Dual-URL config for two-port VTN
 :bl-url  "http://localhost:8081/openadr3/3.1.0"
 :ven-url "http://localhost:8080/openadr3/3.1.0"

 ;; Auth tokens — base64(client_id:secret)
 :tokens {:ven1 "dmVuX2NsaWVudDo5OTk="       ;; ven_client:999
          :ven2 "dmVuX2NsaWVudDI6OTk5OQ=="    ;; ven_client2:9999
          :bl   "YmxfY2xpZW50OjEwMDE="        ;; bl_client:1001
          :bad  "bad_token"}

 ;; VTN capability profile. :handlers and per-port reachability are
 ;; auto-detected at startup; declare here only what auto-detection can't
 ;; know (or what we want to assert in the report regardless).
 :capabilities
 {:notifiers   #{:MQTT}                       ;; clj-oa3-vtn supports MQTT only (no WEBHOOK yet)
  :http-auth   {:enforced? false}             ;; doesn't currently support auth — skips ^:auth tests
  :ven-routes  {:subscriptions false}}        ;; subscriptions disabled on VEN port by default

 ;; Defaults (not overridden here): programs and events default to
 ;; :read-only on the VEN port. vens/resources/reports handlers aren't
 ;; implemented yet, so their absence is auto-detected and the
 ;; corresponding suites get gated to N/A by the capability-gate plugin.

 ;; --- Legacy keys (kept commented for one deprecation cycle) ---
 ;; :expected-notifiers #{:MQTT}
 ;; :auth-enforced? false
 ;; :ven-routes {:subscriptions false}

 ;; No delay needed — Clojure VTN handles connections properly
 :inter-suite-delay-ms 0}
