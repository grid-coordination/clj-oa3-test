;; Test configuration — clj-oa3-vtn 0.12.1 (all VEN routes enabled)
;; Two-port architecture (BL on 8081, VEN on 8080) with VEN subscription
;; CRUD enabled on the VEN port.
;;
;; Requires VTN started with ven-routes subscriptions enabled, e.g.:
;;   CLJ_OA3_VTN_CONFIG=path/to/config.edn  (with :ven-routes {:subscriptions :full})
;;
;; clj-oa3-vtn 0.12.1 implements: programs, events, subscriptions, notifiers,
;; MQTT publish, and the 12 MQTT topic discovery endpoints. VENs, resources,
;; and reports handlers are not yet implemented — focus only the suites that
;; the VTN supports.
;;
;; Auth: not enforced in 0.12.1 (Phase 1). :auth-enforced? false below
;; short-circuits the ^:auth tests.
;; Notifiers: MQTT only — no WEBHOOK delivery yet.
;;
;; Known failures observed against 0.12.1 (2026-05-08, anonymous MQTT) are
;; the same as in test-config.clj-oa3-vtn.edn: PUT /programs 500 with
;; :targets, and three GET /events search/pagination failures. See the
;; sibling file for full detail.
;;
;; Usage:
;;   cp test-config.clj-oa3-vtn-full.edn test-config.edn
;;   # Start clj-oa3-vtn with subscription routes enabled, then:
;;   clojure -M:test --focus :notifiers --focus :programs --focus :events \
;;                   --focus :subscriptions

{;; Dual-URL config for two-port VTN
 :bl-url  "http://localhost:8081/openadr3/3.1.0"
 :ven-url "http://localhost:8080/openadr3/3.1.0"

 ;; Auth tokens — base64(client_id:secret)
 :tokens {:ven1 "dmVuX2NsaWVudDo5OTk="       ;; ven_client:999
          :ven2 "dmVuX2NsaWVudDI6OTk5OQ=="    ;; ven_client2:9999
          :bl   "YmxfY2xpZW50OjEwMDE="        ;; bl_client:1001
          :bad  "bad_token"}

 ;; VTN capability profile. :handlers and per-port reachability are
 ;; auto-detected at startup. Requires VTN started with VEN subscription
 ;; routes enabled (CLJ_OA3_VTN_CONFIG with {:ven-routes {:subscriptions :full}}).
 :capabilities
 {:notifiers   #{:MQTT}                       ;; clj-oa3-vtn supports MQTT only (no WEBHOOK yet)
  :http-auth   {:enforced? false}             ;; doesn't currently support auth — skips ^:auth tests
  :ven-routes  {:subscriptions :full}}        ;; VEN subscription CRUD on VEN port

 ;; --- Legacy keys (kept commented for one deprecation cycle) ---
 ;; :expected-notifiers #{:MQTT}
 ;; :auth-enforced? false
 ;; :ven-routes {:subscriptions :full}

 ;; No delay needed — Clojure VTN handles connections properly
 :inter-suite-delay-ms 0}
